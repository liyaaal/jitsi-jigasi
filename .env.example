# Copy to .env. Never commit real keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Groq: https://api.groq.com/openai/v1 (use a Groq key above)
TRANSCRIPTION_MODEL=
SUMMARY_MODEL=
# Empty = automatic language detection; ru = Russian.
TRANSCRIPTION_LANGUAGE=
RECORD_DURATION_MS=1800000
HEADLESS=true
# No uploads when true; process later with npm run transcribe -- recordings/<session>
RECORD_ONLY=false
